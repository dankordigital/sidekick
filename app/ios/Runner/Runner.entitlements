<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Joining another device's Wi-Fi for a direct link (HotspotJoiner in AppDelegate.swift). -->
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<!-- Shared with the SidekickLive extension: what the home-screen widgets show. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.sidekick.sidekick</string>
	</array>
</dict>
</plist>
