# Sidekick's website (getsidekick.app, OVHcloud; Apache).
# Upload this next to index.html (the site's root folder, "www").

# Any address that doesn't exist shows 404.html, at the same address (no
# redirect), with a real "404 Not Found" status.
ErrorDocument 404 /404.html

# No folder listings (e.g. /website/): those show the 404 page too.
Options -Indexes
ErrorDocument 403 /404.html

# Not in search results yet: every file (pages, images, sounds) tells search
# engines not to list it. robots.txt lets the big ones read this, and keeps
# every other bot out. To be found on Google, remove this, robots.txt and
# the robots tags in the pages.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
</IfModule>

# The home page goes through index.php, which counts the visit and shows the
# wishlist or, once released (np7dpanel.php → Website), the downloads.
DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.html$ /index.php [L]
</IfModule>

# The preview (preview.html) runs Sidekick compiled for a browser, from
# website/app/: browsers want its WebAssembly served as such.
AddType application/wasm .wasm
